# Test environment for the API integration suite (jest.api.config.js / tests/api/**).
# NEVER point DATABASE_URL at drms_dev or a production database.
# tests/setup-api.ts enforces that DATABASE_URL contains "drms_test" and refuses to run otherwise.
DATABASE_URL="postgresql://dms_dev:dev_password_change_in_prod@localhost:5435/drms_test?schema=public"
JWT_SECRET="test-suite-jwt-secret"
JWT_EXPIRES_IN="24h"
REDIS_ENABLED="false"
NODE_ENV="test"
NEXT_PUBLIC_APP_NAME="DMS Test"
NEXT_PUBLIC_APP_VERSION="0.1.0"
