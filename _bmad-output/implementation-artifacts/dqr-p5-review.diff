+      entityId: 'entity-1',
+      incidentId: 'incident-1',
+      timestamp: 123,
+      autoSaved: true,
+      data: { answers: { hasFunctionalClinic: false, goneQuestion: 'legacy' }, assessorName: 'Field Officer' },
+    }
+    window.localStorage.setItem(DRAFTS_STORAGE_KEY, JSON.stringify([draft]))
