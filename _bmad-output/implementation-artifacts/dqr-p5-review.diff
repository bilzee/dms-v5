+    window.localStorage.setItem(DRAFTS_STORAGE_KEY, '{not json')
+    expect(() =>
+      applyDraftMigration(
+        { id: 'draft_7', assessmentType: 'HEALTH', data: { answers: { hasFunctionalClinic: false } } },
+        { assessmentType: type, snapshot }
