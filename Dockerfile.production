# Production Dockerfile for Disaster Management System
# Multi-stage build for optimized production image

# =======================================
# Stage 1: Dependencies
# =======================================
FROM node:20.18-alpine AS deps
WORKDIR /app

COPY package.json pnpm-lock.yaml* ./
# Direct pnpm install (not corepack): the corepack bundled with older Node
# patch releases cannot verify npm's current registry signatures.
RUN npm install -g pnpm@9.15.4 && pnpm install --no-frozen-lockfile

# =======================================
# Stage 2: Builder
# =======================================
FROM node:20.18-alpine AS builder
WORKDIR /app

ARG DATABASE_URL="postgresql://user:pass@localhost:5432/db"
ENV DATABASE_URL=$DATABASE_URL
ENV NEXT_BUILD=true

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NODE_ENV=production

RUN npm install -g pnpm@9.15.4
RUN npx prisma generate
RUN pnpm run build:production

# =======================================
# Stage 3: Runner (Production)
# =======================================
FROM node:20.18-alpine AS production
WORKDIR /app

RUN apk add --no-cache wget openssl

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder /app/package.json ./package.json
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma
# Seed scripts import from src/lib (questions, services, validation) — the
# whole src tree ships so every seed-time import resolves at runtime.
# tsconfig.json is required by tsx to resolve the `@/*` path aliases used
# by the service modules.
COPY --from=builder --chown=nextjs:nodejs /app/src ./src
COPY --from=builder --chown=nextjs:nodejs /app/tsconfig.json ./tsconfig.json

# Full node_modules (pnpm store + top-level symlinks) — seed scripts run
# outside Next's dependency trace, so they resolve deps the same way the
# builder did. Includes tsx (dev dep, seed runner). Merges with the
# standalone tree copied above.
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules

RUN chown -R nextjs:nodejs /app/public

COPY --chown=nextjs:nodejs start-with-migrations.sh /app/start-with-migrations.sh
RUN chmod +x /app/start-with-migrations.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1

USER nextjs

EXPOSE 3000

CMD ["/app/start-with-migrations.sh"]
